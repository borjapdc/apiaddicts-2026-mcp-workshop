<policies>
	<inbound>
		<base />
		<choose>
			<when condition="@(context.Subscription == null || context.Product == null || context.Product.Id != &quot;${product}&quot;)">
				<return-response>
					<set-status code="403" reason="Forbidden" />
				</return-response>
			</when>
		</choose>
		<rate-limit-by-key calls="${calls}" renewal-period="${period}" counter-key="@(context.Subscription.Id + &quot;:&quot; + context.Api.Id)" remaining-calls-header-name="X-RateLimit-Remaining" />
		<set-header name="x-correlation-id" exists-action="override">
			<value>@(context.RequestId.ToString())</value>
		</set-header>
		<set-header name="x-backend-token" exists-action="override">
			<value>{{${origin_secret}}}</value>
		</set-header>
		<set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
		<trace source="apiaddicts-mcp" severity="information">
			<message>Governed synthetic MCP request</message>
			<metadata name="correlation-id" value="@(context.RequestId.ToString())" />
			<metadata name="api-id" value="@(context.Api.Id)" />
		</trace>
	</inbound>
	<backend>
		<forward-request buffer-response="false" />
	</backend>
	<outbound>
		<base />
		<set-header name="x-correlation-id" exists-action="override">
			<value>@(context.RequestId.ToString())</value>
		</set-header>
	</outbound>
	<on-error>
		<base />
	</on-error>
</policies>